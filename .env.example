# Copy to .env (gitignored). NEVER commit real values -- this repo is PUBLIC.
# All real secrets live in Secret Manager (agreement 2.4).

# --- GCP ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1
GCS_DOCUMENTS_BUCKET=ef-documents
GCS_DATASETS_BUCKET=ef-datasets

# --- Models (§1.4, locked; amended 2026-08-21) ---
# Gemma 4 returns TWO parts: one with thought=True, then the answer. Filter
# thought parts or you get reasoning instead of the label. thinkingBudget is
# NOT supported on Gemma 4 -- thinking cannot be disabled.
GEMINI_MODEL=gemini-3.7-flash
GEMMA_MODEL=gemma-4-26b-a4b-it

# --- Pub/Sub topics (contract §3.2) ---
TOPIC_INTAKE_EMAIL_RECEIVED=intake.email.received
TOPIC_CASE_DOCUMENT_ADDED=case.document.added
TOPIC_CASE_ANALYSIS_COMPLETE=case.analysis.complete
TOPIC_FILING_REQUESTED=filing.requested
TOPIC_FILING_COMPLETED=filing.completed

# --- Vendors (TEST MODE ONLY -- guardrail: never a real hospital destination) ---
PHAXIO_API_KEY=
PHAXIO_API_SECRET=
LOB_API_KEY=test_...
DEMO_FAX_ALLOWLIST=
DEMO_MAIL_ALLOWLIST=

# --- Google APIs (Gmail, Calendar, Drive all act as the ONE demo Google
# account -- see infra/OAUTH.md for how to mint GOOGLE_OAUTH_REFRESH_TOKEN;
# added here per agreement §2.4, "every var" -- these three were previously
# undocumented even though services/intake and packages/delivery have read
# them since WO7) ---
GMAIL_DEMO_ADDRESS=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_ADVOCATE_EMAIL=
